{
  "name": "@motionpr/report",
  "version": "0.5.0-alpha",
  "private": true,
  "description": "MotionPR report: interactive motion-inspection viewer (React) and offline HTML report generator.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/generator/index.ts",
    "./viewer": "./src/viewer/index.ts",
    "./viewer.css": "./src/viewer/styles/viewer.css"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.viewer.json"
  },
  "dependencies": {
    "@motionpr/core": "workspace:*",
    "gsap": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "catalog:",
    "vitest": "catalog:",
    "@motionpr/comparison": "workspace:*"
  }
}
